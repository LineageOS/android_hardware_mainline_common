      "side": 1,
      "message": "Not how you do that.\n\nYou store the fd inside the sensor struct, then setup a thread that polls on the fd.\n\n```cpp\nvoid IioBufferStreamer::stream_loop() {\n    struct pollfd fds[2];\n    fds[0].fd \u003d buffer_fd_;\n    fds[0].events \u003d POLLIN;\n    fds[1].fd \u003d pipe_fd_[0];\n    fds[1].events \u003d POLLIN;\n\n    std::vector\u003cuint8_t\u003e raw_buf(sample_size_bytes_ * 16);\n\n    while (running_.load()) {\n        int ret \u003d poll(fds, 2, -1);\n        if (ret \u003c\u003d 0) {\n            if (errno \u003d\u003d EINTR) continue;\n            break;\n        }\n\n        if (fds[1].revents \u0026 POLLIN) break;\n\n        if (fds[0].revents \u0026 POLLIN) {\n            ssize_t bytes_read \u003d read(buffer_fd_, raw_buf.data(), raw_buf.size());\n            if (bytes_read \u003e\u003d static_cast\u003cssize_t\u003e(sample_size_bytes_)) {\n                size_t samples \u003d bytes_read / sample_size_bytes_;\n                for (size_t s \u003d 0; s \u003c samples; ++s) {\n                    const uint8_t* sample_ptr \u003d raw_buf.data() + (s * sample_size_bytes_);\n                    SampleRecord record;\n\n                    for (const auto\u0026 ch : scan_channels_) {\n                        if (ch.name \u003d\u003d \"in_timestamp\") {\n                            const uint8_t* ptr \u003d sample_ptr + ch.offset_bytes;\n                            int64_t ts \u003d *reinterpret_cast\u003cconst int64_t*\u003e(ptr);\n                            if (ch.is_big_endian) ts \u003d __builtin_bswap64(ts);\n                            record.timestamp_ns \u003d ts;\n                        } else {\n                            record.channels.emplace_back(ch.name, ch.decode(sample_ptr));\n                        }\n                    }\n\n                    if (callback_) {\n                        callback_(record);\n                    }\n                }\n            }\n        }\n    }\n}```\n\nRandom example I have locally (ignore the timestamp stuff)\n\nAlso apparently unused as a whole and you only have \"poll\" based approach (vs real poll base that\u0027s this)",
      "revId": "df26b05606d5b6889fde8f1e21a09cc4f8cd709b",
