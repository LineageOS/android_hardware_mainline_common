<!-- Support for external (hotplugged) cameras. Same features as
     frameworks/native/data/etc/android.hardware.camera.external.xml, which
     has no prebuilt_etc module to bundle into the APEX. -->
<permissions>
    <feature name="android.hardware.camera.any" />
    <feature name="android.hardware.camera.external" />
</permissions>
