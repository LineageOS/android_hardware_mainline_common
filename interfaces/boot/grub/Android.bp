cc_defaults {
    name: "android.hardware.boot-service.grub_common",
    relative_install_path: "hw",
    defaults: ["libboot_control_defaults"],
    srcs: [
        "BootControl.cpp",
        "main.cpp",
    ],
}

cc_binary {
    name: "android.hardware.boot-service.grub",
    defaults: ["android.hardware.boot-service.grub_common"],
    vendor: true,

    stl: "c++_static",
    shared_libs: [
        "libbinder_ndk",
        "liblog",
    ],
    static_libs: [
        "android.hardware.boot-V1-ndk",
        "libbase",
        "libgrub_boot_control",
        "libgrub_editenv",
    ],

    installable: false, // installed in APEX
}

cc_binary {
    name: "android.hardware.boot-service.grub_recovery",
    defaults: ["android.hardware.boot-service.grub_common"],
    init_rc: ["android.hardware.boot-service.grub_recovery.rc"],
    vintf_fragments: ["android.hardware.boot-service.grub.xml"],
    recovery: true,

    shared_libs: [
        "android.hardware.boot-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libgrub_boot_control",
        "libgrub_editenv",
    ],
}

prebuilt_etc {
    name: "android.hardware.boot-service.grub.rc",
    src: "android.hardware.boot-service.grub.rc",
    installable: false,
}

prebuilt_etc {
    name: "android.hardware.boot-service.grub.xml",
    src: "android.hardware.boot-service.grub.xml",
    sub_dir: "vintf",
    installable: false,
}

apex {
    name: "com.android.hardware.boot.grub",
    vendor: true,
    manifest: "apex_manifest.json",
    file_contexts: "apex_file_contexts",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    updatable: false,

    binaries: [
        "android.hardware.boot-service.grub",
    ],
    prebuilts: [
        "android.hardware.boot-service.grub.rc",
        "android.hardware.boot-service.grub.xml",
    ],
}
