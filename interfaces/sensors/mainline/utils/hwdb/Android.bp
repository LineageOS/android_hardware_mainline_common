cc_library {
    name: "libsensors_hwdb",
    vendor: true,
    srcs: [
        "SensorHwdb.cpp",
    ],
    export_include_dirs: ["include"],
    shared_libs: [
        "libbase",
        "libhwdb",
        "liblog",
        "libsmbios_parser",
    ],
    cflags: [
        "-fvisibility=hidden",
    ],
}
