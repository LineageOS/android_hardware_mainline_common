cc_library_headers {
    name: "libsensors_mainline_headers",
    vendor: true,
    export_include_dirs: ["include"],
    shared_libs: [
        "android.hardware.sensors-V3-ndk",
    ],
}

cc_library_static {
    name: "libsensors_mainline_frontend",
    vendor: true,
    srcs: [
        "Sensors.cpp",
        "SensorBackendManager.cpp",
        "DeviceOrientationSensor.cpp",
    ],
    cflags: select(soong_config_variable("sensors_hal_mainline", "load_custom_backends"), {
        any @ flag_val: ["-DLOAD_CUSTOM_BACKENDS=\"" + flag_val + "\""],
        default: ["-DLOAD_CUSTOM_BACKENDS=\"\""],
    }),
    shared_libs: [
        "android.hardware.sensors-V3-ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libdl",
        "libfmq",
        "liblog",
        "libutils",
    ],
    header_libs: [
        "libsensors_mainline_headers",
    ],
    visibility: [":__subpackages__"],
}

cc_binary {
    name: "android.hardware.sensors-service.mainline",
    vendor: true,
    relative_install_path: "hw",
    installable: false,
    srcs: ["main.cpp"],
    shared_libs: [
        "android.hardware.sensors-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libfmq",
        "liblog",
        "libutils",
    ],
    static_libs: [
        "libsensors_mainline_frontend",
    ],
    header_libs: [
        "libsensors_mainline_headers",
    ],
    visibility: [":__subpackages__"],
}

prebuilt_etc {
    name: "sensors-mainline.rc",
    vendor: true,
    src: "sensors-mainline.rc",
    installable: false,
}

prebuilt_etc {
    name: "sensors-mainline-as-root.rc",
    vendor: true,
    src: "sensors-mainline-as-root.rc",
    installable: false,
}

prebuilt_etc {
    name: "sensors-mainline.xml",
    vendor: true,
    src: "sensors-mainline.xml",
    sub_dir: "vintf",
    installable: false,
}

apex {
    name: "com.android.hardware.sensors.mainline",
    manifest: "apex_manifest.json",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    file_contexts: "file_contexts",
    updatable: false,
    vendor: true,

    binaries: ["android.hardware.sensors-service.mainline"],
    prebuilts: [
        "sensors-mainline.xml",
    ] + select(soong_config_variable("sensors_hal_mainline", "run_as_root"), {
        true: ["sensors-mainline-as-root.rc"],
        default: ["sensors-mainline.rc"],
    }) + select(soong_config_variable("sensors_hal_mainline", "include_all_permission_xmls"), {
        true: [
            "android.hardware.sensor.accelerometer.prebuilt.xml",
            "android.hardware.sensor.ambient_temperature.prebuilt.xml",
            "android.hardware.sensor.barometer.prebuilt.xml",
            "android.hardware.sensor.compass.prebuilt.xml",
            "android.hardware.sensor.gyroscope.prebuilt.xml",
            "android.hardware.sensor.light.prebuilt.xml",
            "android.hardware.sensor.proximity.prebuilt.xml",
            "android.hardware.sensor.relative_humidity.prebuilt.xml",
        ],
        default: [],
    }),

    native_shared_libs: [
        "libsensors_iio",
        "libsensors_input",
        "libsensors_mock",
    ] + select(soong_config_variable("sensors_hal_mainline", "include_custom_backends"), {
        any @ flag_val: flag_val,
        default: [],
    }),
}
