cc_library_shared {
    name: "libsensors_iio",
    vendor: true,
    srcs: [
        "IioBackend.cpp",
        "IioScan.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors-V3-ndk",
        "libbase",
        "liblog",
    ],
    static_libs: [
        "libhwdb",
        "libsensors_hwdb",
        "libsmbios_parser",
    ],
    header_libs: [
        "libsensors_mainline_headers",
    ],
    cflags: [
        "-fvisibility=hidden",
    ],
}

cc_test {
    name: "libsensors_iio_scan_test",
    vendor: true,
    srcs: [
        "IioScan.cpp",
        "tests/IioScanTest.cpp",
    ],
    local_include_dirs: ["."],
}
