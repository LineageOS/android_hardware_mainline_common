cc_library_shared {
    name: "libsensors_iio",
    vendor: true,
    srcs: ["IioBackend.cpp"],
    shared_libs: [
        "android.hardware.sensors-V3-ndk",
        "libbase",
        "liblog",
    ],
    header_libs: [
        "libsensors_mainline_headers",
    ],
    cflags: [
        "-fvisibility=hidden",
    ],
}
