apex {
    name: "com.android.hardware.usb.gadget.mainline",
    manifest: "apex_manifest.json",
    file_contexts: "file_contexts",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    updatable: false,
    vendor: true,

    binaries: [
        "android.hardware.usb.gadget-service.mainline",
    ],
    prebuilts: [
        "android.hardware.usb.gadget-service.mainline.rc",
        "android.hardware.usb.gadget-service.mainline.xml",
    ],
}

cc_binary {
    name: "android.hardware.usb.gadget-service.mainline",
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "UsbGadget.cpp",
        "service_gadget.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "android.frameworks.stats-V1-ndk",
        "android.hardware.usb.gadget-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
    ],
    static_libs: [
        "//hardware/google/pixel:libpixelusb-aidl",
    ],
    proprietary: true,
    export_shared_lib_headers: [
        "android.frameworks.stats-V1-ndk",
    ],
}

prebuilt_etc {
    name: "android.hardware.usb.gadget-service.mainline.rc",
    src: "android.hardware.usb.gadget-service.mainline.rc",
    installable: false,
}

prebuilt_etc {
    name: "android.hardware.usb.gadget-service.mainline.xml",
    src: "android.hardware.usb.gadget-service.mainline.xml",
    sub_dir: "vintf",
    installable: false,
}
