cc_binary {
    name: "android.hardware.usb.gadget-service.mainline",
    relative_install_path: "hw",
    init_rc: ["android.hardware.usb.gadget-service.rc"],
    vintf_fragments: [
        "android.hardware.usb.gadget-service.xml",
    ],
    vendor: true,
    srcs: [
        "UsbGadget.cpp",
        "service_gadget.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "android.frameworks.stats-V1-ndk",
        "android.hardware.usb.gadget-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
    ],
    static_libs: [
        "//hardware/google/pixel:libpixelusb-aidl",
    ],
    proprietary: true,
    export_shared_lib_headers: [
        "android.frameworks.stats-V1-ndk",
    ],
}
