package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

soong_config_module_type {
    name: "gralloc_gbm_mesa_apex",
    module_type: "apex",
    config_namespace: "gralloc_gbm_mesa",
    bool_variables: [
        "RELEASE_SM_OPEN_DECLARED_PASSTHROUGH_HAL",
    ],
    properties: [
        "defaults",
    ],
}

gralloc_gbm_mesa_apex {
    name: "com.android.hardware.graphics.allocator.gm",
    manifest: "apex_manifest.json",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    file_contexts: "apex_file_contexts",
    updatable: false,
    vendor: true,

    binaries: [
        "android.hardware.graphics.allocator-service.gm",
    ],
    prebuilts: [
        "android.hardware.graphics.allocator-service.gm.xml", // vintf
        "com.android.hardware.graphics.allocator.gm.rc", // init_rc
        "com.android.hardware.graphics.allocator.gm-linker-config", // make the apex namespace visible for mapper library
    ],
    overrides: [
        "android.hardware.graphics.allocator-service.gm",
    ],

    soong_config_variables: {
        RELEASE_SM_OPEN_DECLARED_PASSTHROUGH_HAL: {
            defaults: [
                "com.android.hardware.graphics.allocator.gm-mapper-defaults",
            ],
            conditions_default: {},
        },
    },
}

apex_defaults {
    name: "com.android.hardware.graphics.allocator.gm-mapper-defaults",

    // for app_process32 apps
    compile_multilib: "both",

    native_shared_libs: [
        "mapper.gm",
    ],
    prebuilts: [
        "mapper.gm.xml", // vintf
    ],
    overrides: [
        "mapper.gm",
    ],
}

linker_config {
    name: "com.android.hardware.graphics.allocator.gm-linker-config",
    src: "apex_linkerconfig.json",
    installable: false,
}

genrule {
    name: "gen-com.android.hardware.graphics.allocator.gm.rc",
    srcs: [":android.hardware.graphics.allocator-service.gm.rc"],
    out: ["com.android.hardware.graphics.allocator.gm.rc"],
    cmd: "sed -E 's%/vendor/bin/%/apex/com.android.hardware.graphics.allocator/bin/%' $(in) > $(out)",
}

prebuilt_etc {
    name: "com.android.hardware.graphics.allocator.gm.rc",
    src: ":gen-com.android.hardware.graphics.allocator.gm.rc",
    installable: false,
}
